<label class="w3-text-gray" for="family_name">Family Name</label>
<input class="w3-input w3-animate" name="family_name" placeholder="Family Name" value="Doe"></input>

<label class="w3-text-gray" for="given_name">Given Name</label>
<input class="w3-input w3-animate" name="given_name" placeholder="Given Name" value="Jane"></input>

<label class="w3-text-gray" for="birth_date">Birth Date</label>
<input class="w3-input w3-animate" name="birth_date" type="date" value="1991-06-01"></input>

<label class="w3-text-gray" for="birthplace">Birthplace</label>
<input class="w3-input w3-animate" name="birthplace" placeholder="City or country of birth" value="Ottawa"></input>

<label class="w3-text-gray" for="sex">Sex (1=Male, 2=Female, 0=Not specified)</label>
<input class="w3-input w3-animate" name="sex" placeholder="0" value="1"></input>

<label class="w3-text-gray" for="height">Height (cm, optional)</label>
<input class="w3-input w3-animate" name="height" placeholder="Height in cm" value=""></input>

<label class="w3-text-gray" for="weight">Weight (kg, optional)</label>
<input class="w3-input w3-animate" name="weight" placeholder="Weight in kg" value=""></input>

<label class="w3-text-gray" for="nationality">Nationality (alpha-2 or alpha-3, optional)</label>
<input class="w3-input w3-animate" name="nationality" placeholder="e.g. CA or CAN" value=""></input>

<label class="w3-text-gray" for="resident_address">Resident Address</label>
<input class="w3-input w3-animate" name="resident_address" placeholder="Resident Address" value="222 Any Street"></input>

<label class="w3-text-gray" for="resident_city">Resident City</label>
<input class="w3-input w3-animate" name="resident_city" placeholder="Resident City" value="City"></input>

<label class="w3-text-gray" for="resident_state">Resident State / Province</label>
<input class="w3-input w3-animate" name="resident_state" placeholder="Resident State" value="State"></input>

<label class="w3-text-gray" for="resident_postal_code">Resident Postal Code</label>
<input class="w3-input w3-animate" name="resident_postal_code" placeholder="Resident Postal Code" value="MK2 1A0"></input>

<label class="w3-text-gray" for="resident_country">Resident Country (alpha-2 only)</label>
<input class="w3-input w3-animate" name="resident_country" placeholder="e.g. CA" value="CA"></input>

<label class="w3-text-gray" for="issue_date">Issue Date</label>
<input class="w3-input w3-animate" name="issue_date" type="date" value="2023-01-01"></input>

<label class="w3-text-gray" for="expiry_date">Expiry Date</label>
<input class="w3-input w3-animate" name="expiry_date" type="date" value="2033-01-01"></input>

<label class="w3-text-gray" for="issuing_authority_unicode">Issuing Authority</label>
<input class="w3-input w3-animate" name="issuing_authority_unicode" placeholder="Issuing Authority" value="Service Canada"></input>

<label class="w3-text-gray" for="issuing_country">Issuing Country (alpha-2 or alpha-3)</label>
<input class="w3-input w3-animate" name="issuing_country" placeholder="e.g. CA or CAN" value="CA"></input>

<label class="w3-text-gray" for="issuing_subdivision">Issuing Subdivision (ISO 3166-2, optional)</label>
<input class="w3-input w3-animate" name="issuing_subdivision" placeholder="e.g. CA-ON" value=""></input>

<label class="w3-text-gray" for="document_number">Document Number</label>
<input class="w3-input w3-animate" name="document_number" placeholder="Document Number" value="ID123456789"></input>

<label class="w3-text-gray" for="document_type">Document Type (optional)</label>
<input class="w3-input w3-animate" name="document_type" placeholder="e.g. ID, eID" value="ID"></input>

<label class="w3-text-gray" for="portrait">Portrait (base64)</label>
<input class="w3-input w3-animate" name="portrait" placeholder="base64-encoded portrait image"></input>

<label class="w3-text-gray" for="age_over_18">Age Over 18</label>
<select class="w3-input w3-animate" name="age_over_18">
  <option value="true" selected>true</option>
  <option value="false">false</option>
</select>

<label class="w3-text-gray" for="age_over_21">Age Over 21</label>
<select class="w3-input w3-animate" name="age_over_21">
  <option value="true" selected>true</option>
  <option value="false">false</option>
</select>

<button class="w3-bar w3-btn w3-green" type="submit">Issue Photo ID</button>
